# Telegram bot token from @BotFather (for @neo6morpheus9bot)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram chat IDs allowed to use the bot.
# Leave empty to allow all chats (not recommended for production).
TELEGRAM_ALLOWED_CHAT_IDS=

# Your Firefly III base URL (no trailing slash)
FIREFLY_BASE_URL=http://localhost

# Firefly III personal access token (Profile → OAuth → Personal Access Tokens)
FIREFLY_API_TOKEN=

# Webhook mode (optional — leave blank to use polling mode)
WEBHOOK_URL=
WEBHOOK_PORT=8443
