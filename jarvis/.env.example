# Claude API
ANTHROPIC_API_KEY=your_key_here

# Hermes (local via Ollama — default port)
HERMES_BASE_URL=http://localhost:11434
HERMES_MODEL=hermes3

# Obsidian vault path (absolute path to your vault)
OBSIDIAN_VAULT_PATH=/Users/yourname/Documents/MyVault

# Which model sits in the foreman chair
FOREMAN_MODEL=claude-fable-5
# Cheaper model for workers (can be Hermes to save cost)
WORKER_MODEL=hermes  # "hermes" routes to local Ollama, any other value = Claude model name

# Night shift cron schedule (default: 2am every day)
NIGHTSHIFT_CRON=0 2 * * *
