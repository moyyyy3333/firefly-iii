# ---- Telegram (the trigger) ----
TELEGRAM_BOT_TOKEN=
# Only these Telegram user IDs may trigger the pipeline (comma separated).
TELEGRAM_ALLOWED_USER_IDS=

# ---- Claude (website generation) ----
ANTHROPIC_API_KEY=
# Latest, most capable model for design-quality output.
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Google Places (lead discovery) ----
GOOGLE_MAPS_API_KEY=

# ---- Stripe (checkout link, NOT an invoice) ----
STRIPE_SECRET_KEY=
# Price the buyer pays, in the smallest currency unit. 9900 = $99.00
SITE_PRICE_CENTS=9900
SITE_CURRENCY=usd
# Optional recurring hosting/edits plan price id (leave blank to skip).
STRIPE_HOSTING_PRICE_ID=

# ---- Outreach email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=Your Studio Name
FROM_EMAIL=hello@yourstudio.com
REPLY_TO_EMAIL=hello@yourstudio.com

# CAN-SPAM requires a real physical mailing address in every commercial email.
SENDER_POSTAL_ADDRESS=123 Example St, Suite 100, Your City, ST 00000
# Where opt-outs are collected/honored (a real, monitored inbox or URL).
UNSUBSCRIBE_EMAIL=unsubscribe@yourstudio.com

# ---- Preview server (expiring, watermarked links) ----
# Public URL where the preview server is reachable (used to build links).
PREVIEW_BASE_URL=http://localhost:8080
PREVIEW_PORT=8080
# Link breaks this many hours AFTER the recipient first opens it.
PREVIEW_TTL_HOURS=36

# ---- Safety rails ----
# Hard cap on outreach emails sent per run. Keeps you sane and compliant.
MAX_OUTREACH_PER_RUN=25
# Dry run: build sites + draft emails but DO NOT send anything.
DRY_RUN=true
